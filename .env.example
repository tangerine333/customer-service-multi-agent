# ============================================================
# Code Review Agent - Environment Configuration
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://code_review:code_review@localhost:5432/code_review
REDIS_URL=redis://localhost:6379/0

# --- vLLM / Model ---
VLLM_API_URL=http://localhost:8000/v1
VLLM_MODEL_NAME=deepseek-coder-33b-instruct
LLM_TIMEOUT_SECONDS=5
LLM_MAX_RETRIES=3

# --- Analysis ---
MAX_ANALYSIS_FILES_PER_MR=500
CALL_GRAPH_HOP_LIMIT=2
TAINT_ANALYSIS_DEPTH=5
SUMMARY_CACHE_TTL_SECONDS=3600

# --- CI Integration ---
GITHUB_TOKEN=
GITLAB_TOKEN=
CI_MODE=false

# --- Logging ---
LOG_LEVEL=INFO
RUST_LOG=info
